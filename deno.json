{
  "name": "@kiri23/ontology-client",
  "version": "0.1.1",
  "license": "MIT",
  "exports": {
    ".": "./mod.ts",
    "./cli": "./cli.ts",
    "./neo4j": "./neo4j.ts"
  },
  "imports": {
    "@cfworker/json-schema": "npm:@cfworker/json-schema@4.1.1",
    "@std/assert": "jsr:@std/assert@^1.0.13",
    "@std/cli": "jsr:@std/cli@^1.0.20",
    "neo4j-driver": "npm:neo4j-driver@^6.2.0",
    "openapi-fetch": "npm:openapi-fetch@^0.17.0",
    "openapi-typescript": "npm:openapi-typescript@7.13.0"
  },
  "tasks": {
    "contrato": "deno run --allow-net --allow-env=ONTOLOGY_CONTRATO_URL --allow-write=contrato --allow-read --allow-run scripts/contrato.ts",
    "neo4j:cargar": "deno run --allow-net --allow-env --allow-sys=osRelease scripts/neo4j-cargar.ts",
    "neo4j:hola": "deno run --allow-net --allow-env=NEO4J_URL,NEO4J_PASSWORD --allow-sys=osRelease ejemplos/hola-neo4j.ts",
    "generar": "deno run --allow-read --allow-write=generado --allow-env --allow-sys scripts/generar.ts",
    "hooks": "mkdir -p $HOME/.local/share/git-hooks/ontology-client && printf '#!/bin/sh\\n[ -f .githooks/pre-commit ] || exit 0\\nexec sh .githooks/pre-commit \"$@\"\\n' > $HOME/.local/share/git-hooks/ontology-client/pre-commit && chmod +x $HOME/.local/share/git-hooks/ontology-client/pre-commit && git config core.hooksPath $HOME/.local/share/git-hooks/ontology-client && echo 'pre-commit activo: fmt, lint, tipos y tests antes de cada commit'",
    "test": "deno test --allow-net --allow-read --allow-env --allow-run --allow-sys=osRelease"
  },
  "lock": {
    "frozen": true
  },
  "exclude": ["explorador/node_modules/", "explorador/dist/"],
  "test": {
    "exclude": ["explorador/"]
  },
  "fmt": {
    "lineWidth": 120,
    "exclude": ["generado/", "explorador/package-lock.json"]
  },
  "lint": {
    "exclude": ["generado/"]
  },
  "publish": {
    "include": [
      "mod.ts",
      "cliente.ts",
      "jobs.ts",
      "motor.ts",
      "neo4j.ts",
      "vista-neo4j.ts",
      "sparql.ts",
      "cli.ts",
      "generado/api.ts",
      "contrato/openapi.json",
      "README.md",
      "neo4j/README.md",
      "LICENSE"
    ],
    "exclude": ["explorador/"]
  }
}
