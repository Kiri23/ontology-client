# El servidor estático del explorador, dentro de su contenedor. kiri-edge (el Caddy del borde, con TLS) le manda
# /explorador* de ontology.kiri231.com; el resto del sitio es de ontology-web y ontology-grlc. TLS y admin son del
# borde: acá no hay ninguno de los dos, ni config persistida.
{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	# Los assets cuelgan de /explorador/: sin la barra, el navegador los pediría a /assets/.
	redir /explorador /explorador/ 308

	# La página guarda tokens en sessionStorage: solo corre el JS propio y solo le habla a su origen (la API) y, por
	# "Preguntar con AI", a Hugging Face. 'wasm-unsafe-eval' deja compilar WebAssembly (oxigraph y onnxruntime, assets
	# propios); no habilita eval de JS. La AI (src/grafo/ai/, docs/gemma-en-el-navegador.md §3) suma tres cosas y nada
	# más: connect-src a la ruta del modelo en huggingface.co, no al host entero (su API acepta escrituras: sería un
	# canal para sacar tokens), y a *.hf.co (los pesos redirigen a us.aws.cdn.hf.co; la región varía; CSP3 no mira la
	# ruta después de un redirect). Transformers.js pide todo bajo {modelo}/resolve/{revisión}/.
	# blob: en script-src (Transformers.js importa la fábrica del wasm de onnxruntime como Blob) y worker-src 'self'
	# blob: (el worker propio; onnxruntime arma los suyos como blob: si hay hilos). default-src va primero:
	# scripts/humo-imagen lo busca.
	header {
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; img-src 'self' data:; style-src 'self'; font-src 'self'; connect-src 'self' https://huggingface.co/onnx-community/gemma-4-E2B-it-ONNX/ https://*.hf.co; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
	# Los assets llevan hash en el nombre; el index no, así un deploy nuevo se ve al recargar.
	header /explorador/assets/* Cache-Control "public, max-age=31536000, immutable"
	header /explorador/ Cache-Control "no-cache"

	# Preview de un PR (.github/workflows/preview.yml): el contenedor corre solo en una VM, sin kiri-edge ni la API al
	# lado. Con API_UPSTREAM, la raíz lleva al explorador y los GET de la API (lo que el SDK pide por el mismo origen)
	# van al servidor real. Solo GET: una acción corrida desde un preview no escribe en producción. Sin la variable
	# (producción, humo-imagen) nada de esto matchea: / y /jobs dan 404 como siempre.
	@preview-raiz {
		expression `{env.API_UPSTREAM} != ""`
		path /
	}
	redir @preview-raiz /explorador/ 308
	@preview-api {
		expression `{env.API_UPSTREAM} != ""`
		method GET
		path /sparql /sparql/* /jobs /jobs/* /proyectos /preguntar /reportes/* /openapi.json
	}
	handle @preview-api {
		reverse_proxy {$API_UPSTREAM} {
			header_up Host {upstream_hostport}
		}
	}

	file_server
}
