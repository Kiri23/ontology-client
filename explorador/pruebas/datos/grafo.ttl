    ns1:tieneWorkflow <https://kiri23.dev/repos/workflow/MyClaudeSkills.kiri-pm> .

<https://github.com/Kiri23/ontologyLearning> a doap:Project ;
    doap:name "ontologyLearning" ;
    ns1:ejecutaEnCI <https://github.com/Kiri23/TermuxConfig#.github/actions/pm-actividad>,
        <https://github.com/actions/checkout#.>,
        <https://github.com/docker/build-push-action#.>,
        <https://github.com/docker/login-action#.>,
        <https://github.com/docker/setup-buildx-action#.>,
