    ns1:esPublico false ;
    ns1:tieneWorkflow <https://kiri23.dev/repos/workflow/ontologyLearning.deploy>,
        <https://kiri23.dev/repos/workflow/ontologyLearning.kiri-pm> .

<https://github.com/Kiri23/portfolio> a doap:Project ;
    doap:name "portfolio" ;
    ns1:ejecutaEnCI <https://github.com/Kiri23/TermuxConfig#.github/actions/pm-actividad>,
        <https://github.com/actions/checkout#.>,
        <https://github.com/docker/build-push-action#.>,
        <https://github.com/docker/login-action#.>,
        <https://github.com/docker/setup-buildx-action#.>,
        <https://github.com/tailscale/github-action#.> ;
    ns1:esPublico true ;
    ns1:tieneWorkflow <https://kiri23.dev/repos/workflow/portfolio.container>,
        <https://kiri23.dev/repos/workflow/portfolio.kiri-pm> .

<https://github.com/Kiri23/rutero> a doap:Project ;
    doap:name "rutero" ;
    ns1:ejecutaEnCI <https://github.com/Kiri23/TermuxConfig#.github/actions/pm-actividad>,
        <https://github.com/actions/checkout#.>,
        <https://github.com/docker/build-push-action#.>,
        <https://github.com/docker/login-action#.>,
        <https://github.com/docker/setup-buildx-action#.>,
        <https://github.com/tailscale/github-action#.> ;
    ns1:esPublico false ;
    ns1:tieneWorkflow <https://kiri23.dev/repos/workflow/rutero.deploy>,
        <https://kiri23.dev/repos/workflow/rutero.e2e>,
        <https://kiri23.dev/repos/workflow/rutero.kiri-pm> .

ns1:accion a rdf:Property ;
    rdfs:comment "El uso apunta a esta action." ;
    rdfs:domain ns1:Uso ;
    rdfs:range ns1:Action .

ns1:alojadaEn a rdf:Property ;
    rdfs:comment "La action vive en este repo." ;
    rdfs:domain ns1:Action ;
    rdfs:range doap:Project .

ns1:archivo a rdf:Property ;
    rdfs:comment "La ruta del workflow dentro del repo, por ejemplo .github/workflows/kiri-pm.yml." ;
    rdfs:domain ns1:Workflow ;
    rdfs:range xsd:string .

ns1:ejecutaEnCI a rdf:Property ;
    rdfs:comment "Atajo de tieneWorkflow/tieneUso/accion: el CI del repo ejecuta esta action en alguno de sus workflows. Lo escribe el generador junto con cada Uso; SHACL verifica que coincidan. No es la dependencia declarada (eso va en proyecto.ttl)." ;
    rdfs:domain doap:Project ;
    rdfs:range ns1:Action .

ns1:esPublico a rdf:Property ;
    rdfs:comment "Un repo público no puede usar una action de un repo privado." ;
    rdfs:domain doap:Project ;
    rdfs:range xsd:boolean .

ns1:ref a rdf:Property ;
    rdfs:comment "La versión que pide el uso: una rama, un tag o un SHA." ;
    rdfs:domain ns1:Uso ;
    rdfs:range xsd:string .

ns1:ruta a rdf:Property ;
    rdfs:comment "Ruta de la action dentro de su repo, por ejemplo .github/actions/pm-actividad." ;
    rdfs:domain ns1:Action ;
    rdfs:range xsd:string .

ns1:tieneUso a rdf:Property ;
    rdfs:comment "El workflow declara este uso." ;
    rdfs:domain ns1:Workflow ;
    rdfs:range ns1:Uso .

ns1:tieneWorkflow a rdf:Property ;
    rdfs:comment "El repo tiene este workflow." ;
    rdfs:domain doap:Project ;
    rdfs:range ns1:Workflow .

ns2:aplicadoEl a rdf:Property ;
    rdfs:comment "Cuándo apliqué. Lo escribe la acción j:MarcarAplicado." ;
    rdfs:domain ns2:JobPost ;
    rdfs:range xsd:dateTime .

ns2:descartadoEl a rdf:Property ;
    rdfs:comment "Cuándo lo descarté. Lo escribe la acción j:Descartar." ;
    rdfs:domain ns2:JobPost ;
    rdfs:range xsd:dateTime .

ns2:empresa a rdf:Property ;
    rdfs:comment "Quién publica el puesto." ;
    rdfs:domain ns2:JobPost .

ns2:pide a rdf:Property ;
    rdfs:comment "El texto del puesto menciona esta Technology (por nombre o sinónimo)." ;
    rdfs:domain ns2:JobPost ;
    rdfs:range <https://kiri23.dev/tech#Technology> .

ns2:porque a rdf:Property ;
    rdfs:comment "Por qué lo descarté, en mis palabras." ;
    rdfs:domain ns2:JobPost ;
    rdfs:range xsd:string .

<https://kiri23.dev/tech#Caddy> a <https://kiri23.dev/tech#Technology> ;
