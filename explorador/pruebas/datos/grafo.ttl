@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix ns1: <https://kiri23.dev/catalogo#> .
@prefix ns2: <https://kiri23.dev/jobs#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ns1:Action a rdfs:Class ;
    rdfs:comment "Una GitHub Action, identificada por el repo que la aloja y su ruta dentro de él." .

ns1:Uso a rdfs:Class ;
    rdfs:comment "Una dependencia `uses:` de un workflow: la arista hecha objeto, con su ref." .

ns1:Workflow a rdfs:Class ;
    rdfs:comment "Un archivo .github/workflows/x.yml de un repo: un nodo con IRI, que el proyecto puede referenciar." .

ns2:JobPost a rdfs:Class ;
    rdfs:comment "Un puesto publicado por una fuente (Remotive, HN). Su URI es el link del puesto." .

<https://kiri23.dev/tech#Technology> a rdfs:Class ;
    rdfs:label "Technology" ;
    rdfs:comment "Herramienta o plataforma documentable: tiene body propio más allá de back-references." .

<https://github.com/Kiri23/ApiScripts> a doap:Project ;
    doap:name "ApiScripts" ;
    ns1:ejecutaEnCI <https://github.com/Kiri23/TermuxConfig#.github/actions/pm-actividad> ;
    ns1:esPublico false ;
    ns1:tieneWorkflow <https://kiri23.dev/repos/workflow/ApiScripts.kiri-pm> .

<https://github.com/Kiri23/JobSearch> a doap:Project ;
    doap:name "JobSearch" ;
    ns1:ejecutaEnCI <https://github.com/Kiri23/TermuxConfig#.github/actions/pm-actividad>,
        <https://github.com/actions/checkout#.>,
        <https://github.com/actions/setup-python#.> ;
    ns1:esPublico false ;
    ns1:tieneWorkflow <https://kiri23.dev/repos/workflow/JobSearch.kiri-pm>,
        <https://kiri23.dev/repos/workflow/JobSearch.valida-issues> .

<https://github.com/Kiri23/MyClaudeSkills> a doap:Project ;
    doap:name "MyClaudeSkills" ;
    ns1:ejecutaEnCI <https://github.com/Kiri23/TermuxConfig#.github/actions/pm-actividad> ;
