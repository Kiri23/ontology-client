#!/usr/bin/env bash
# Humo de la imagen antes de publicarla (deploy.yml, también en PRs). Todo se captura antes del grep (pipefail).
set -euo pipefail
IMAGEN="${1:?uso: explorador/scripts/humo-imagen <imagen>}" B="http://127.0.0.1:8080" C=ontology-explorador-humo
fallo() { echo "FALLA: $*" >&2; docker logs "$C" 2>&1 | tail -20 >&2 || true; exit 1; }
trap 'docker rm -f "$C" >/dev/null 2>&1 || true' EXIT
cabeceras() { curl -s -o /dev/null -D - "$1" | tr -d '\r'; }
tiene() { grep -qi -- "$1" <<<"$2"; }
imagenes="$(IMAGE_TAG="${IMAGEN##*:}" docker compose -f "$(dirname "$0")/../compose.prod.yaml" config --images)"
grep -qx "$IMAGEN" <<<"$imagenes" || fallo "la imagen no se llama como en compose.prod.yaml"
docker run -d --name "$C" -p 127.0.0.1:8080:8080 "$IMAGEN" >/dev/null
for _ in $(seq 1 30); do curl -sf -o /dev/null "$B/explorador/" && break; sleep 1; done
tiene '^location: /explorador/$' "$(cabeceras "$B/explorador")" || fallo "/explorador no redirige a /explorador/"
html="$(curl -sf "$B/explorador/")" || fallo "/explorador/ no contesta"
tiene 'id="raiz"' "$html" || fallo "/explorador/ no es el index del explorador"
tiene "^content-security-policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:;.* connect-src 'self' https://huggingface.co/onnx-community/gemma-3-270m-it-ONNX/ https://\*.hf.co;" "$(cabeceras "$B/explorador/")" || fallo "CSP sin lo que piden el Grafo y la AI"
assets="$(grep -o '/explorador/assets/[^"]*' <<<"$html")" || fallo "el index no referencia assets"
js="$(grep '\.js$' <<<"$assets")" || fallo "el index no trae el JS"
css="$(grep '\.css$' <<<"$assets")" || fallo "el index no trae el CSS"
fuentes="$(grep -o '/explorador/assets/[^)]*\.woff2' <<<"$(curl -sf "$B$css")" | sort -u)" || fallo "el CSS no trae fuentes"
! grep -q 'url(data:' <<<"$(curl -sf "$B$css")" || fallo "el CSS trae assets data:, que la CSP bloquea"
for a in $assets $fuentes; do tiene '^HTTP/1.1 200' "$(cabeceras "$B$a")" || fallo "$a no da 200"; done
tiene '^cache-control: .*immutable' "$(cabeceras "$B$js")" || fallo "los assets no van immutable"
tiene 'jobs.marcarAplicado' "$(curl -sf "$B$js")" || fallo "el bundle no trae las historias"
grafo="$(grep -o 'VistaGrafo-[A-Za-z0-9_-]*\.js' <<<"$(curl -sf "$B$js")" | sort -u)" || fallo "no está la vista Grafo"
wasm="$(grep -o 'web_bg-[A-Za-z0-9_-]*\.wasm' <<<"$(curl -sf "$B/explorador/assets/$grafo")" | sort -u)" || fallo "sin wasm"
worker="$(grep -o 'worker-[A-Za-z0-9_-]*\.js' <<<"$(curl -sf "$B/explorador/assets/$grafo")" | head -1)" || fallo "sin worker de AI"
ort="$(grep -o 'ort-wasm-[A-Za-z0-9_.-]*\.wasm' <<<"$(curl -sf "$B/explorador/assets/$worker")")" || fallo "sin wasm de onnxruntime"
for w in "$wasm" "$ort"; do tiene '^content-type: application/wasm' "$(cabeceras "$B/explorador/assets/$w")" || fallo "$w no es application/wasm"; done
[ "$(curl -s -o /dev/null -w '%{http_code}' "$B/")" = 404 ] || fallo "/ no da 404: el contenedor sirve solo /explorador/"
[ "$(docker exec "$C" id -u)" != 0 ] || fallo "corre como root"
echo "humo: OK"
